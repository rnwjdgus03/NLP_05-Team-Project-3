[Unit]
Description=KOSIS v64 fact verification API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kosis-project/service_api
EnvironmentFile=/home/ubuntu/kosis-project/.env
Environment=PYTHONUNBUFFERED=1
Environment=KOSIS_EXPECTED_FREEZE_ID=v64_candidate_20260824_r1
Environment=KOSIS_EXPECTED_CODE_SHA256=760033bbd941a26acd6af1fc0360ef9665ae78d46adc81e80f901c80ce5a7d64
ExecStart=/home/ubuntu/kosis-project/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target