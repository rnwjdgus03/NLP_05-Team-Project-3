[Unit]
Description=KOSIS verification frontend BFF
After=network-online.target kosis-v31b-api.service
Requires=kosis-v31b-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kosis-project/frontend_server
EnvironmentFile=/home/ubuntu/kosis-project/.env
Environment=KOSIS_FRONTEND_HOST=127.0.0.1
Environment=KOSIS_FRONTEND_PORT=3100
Environment=KOSIS_API_BASE_URL=http://127.0.0.1:8000
ExecStart=/home/ubuntu/kosis-project/tools/node/bin/node /home/ubuntu/kosis-project/frontend_server/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
