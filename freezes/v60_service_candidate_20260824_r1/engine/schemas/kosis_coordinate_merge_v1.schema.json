{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kosis_coordinate_merge_v1.schema.json",
  "title": "KOSIS merged coordinate candidates before API comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pipeline_stage", "claim_measurement_id",
    "raw_suggestions", "unique_api_candidate_count",
    "unique_api_candidates", "kosis_api_called"
  ],
  "properties": {
    "schema_version": {"const": "kosis-coordinate-merge-v1"},
    "pipeline_stage": {"const": "coordinate-candidate-merge-before-kosis-api"},
    "claim_measurement_id": {"type": "string", "minLength": 1},
    "raw_suggestions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/localRank1"},
        {"$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/localRank2"},
        {"$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/localRank3"},
        {"$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/mcpRank1"},
        {"$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/mcpRank2"}
      ]
    },
    "unique_api_candidate_count": {"type": "integer", "minimum": 1, "maximum": 5},
    "unique_api_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/apiCandidate"}
    },
    "kosis_api_called": {"const": false}
  },
  "$defs": {
    "sourceSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_ranks"],
      "properties": {
        "source": {"enum": ["local_reranker", "kosis_mcp"]},
        "source_ranks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "apiCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_rank", "coordinate_id", "coordinate", "source_support",
        "raw_suggestion_indexes"
      ],
      "properties": {
        "api_rank": {"type": "integer", "minimum": 1, "maximum": 5},
        "coordinate_id": {
          "type": "string",
          "pattern": "^kosis-coordinate-sha256:[0-9a-f]{64}$"
        },
        "coordinate": {
          "$ref": "kosis_coordinate_suggestions_v1.schema.json#/$defs/coordinate"
        },
        "source_support": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/sourceSupport"}
        },
        "raw_suggestion_indexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    }
  }
}
